{
  "name": "hover-trans-port",
  "version": "0.2.20",
  "description": "Chrome MV3 extension that translates selected or hovered text through a local AI CLI native host.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/monk-lee/hover-trans-port.git"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "native-messaging",
    "translation",
    "codex-cli",
    "local-first"
  ],
  "bugs": {
    "url": "https://github.com/monk-lee/hover-trans-port/issues"
  },
  "homepage": "https://github.com/monk-lee/hover-trans-port#readme",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/build-content-script-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-dist.mjs",
    "native:install": "node scripts/install-native-host.mjs",
    "native:uninstall": "node scripts/uninstall-native-host.mjs",
    "helper:build": "cargo build --manifest-path native-helper/Cargo.toml",
    "helper:build:release": "cargo build --release --manifest-path native-helper/Cargo.toml",
    "helper:test": "cargo test --manifest-path native-helper/Cargo.toml",
    "native:installer:check": "node scripts/native-host-installer-check.mjs",
    "native:installer:smoke": "node scripts/native-host-installer-smoke.mjs",
    "native:cross-platform-workflow-check": "node scripts/native-host-cross-platform-workflow-check.mjs",
    "native-host:release-assets:build": "node scripts/build-native-host-release-assets.mjs",
    "macos:script-installer:test": "pnpm native:installer:check",
    "macos:script-installer:build": "bash scripts/build-macos-script-installer-release.sh",
    "windows:script-installer:test": "pnpm native:installer:check",
    "windows:script-installer:smoke": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-windows-native-host.ps1 status",
    "native:protocol-check": "node scripts/native-host-protocol-check.mjs",
    "native:compatibility-check": "node scripts/native-host-compatibility-check.mjs",
    "native:browser-targets-check": "node scripts/native-host-browser-targets-check.mjs",
    "native:paths-check": "node scripts/native-host-paths-check.mjs",
    "native-host-update:check": "node scripts/native-host-update-check.mjs",
    "provider-model-options:check": "node scripts/provider-model-options-check.mjs",
    "popup-options:check": "node scripts/popup-options-open-check.mjs",
    "inline-renderer:check": "node scripts/inline-renderer-check.mjs",
    "translatable-element:check": "node scripts/translatable-element-check.mjs",
    "hover-tracker:check": "node scripts/hover-tracker-check.mjs",
    "youtube-subtitles-shared:check": "node scripts/youtube-subtitles-shared-check.mjs",
    "youtube-caption-tracks:check": "node scripts/youtube-caption-tracks-check.mjs",
    "youtube-transcript-fetch:check": "node scripts/youtube-transcript-fetch-check.mjs",
    "youtube-subtitle-ui:check": "node scripts/youtube-subtitle-ui-check.mjs",
    "youtube-subtitle-session:check": "node scripts/youtube-subtitle-session-check.mjs",
    "youtube-subtitle-protocol:check": "node scripts/youtube-subtitle-protocol-check.mjs",
    "hotkey": "node scripts/hotkey-check.mjs",
    "provider-options:check": "node scripts/provider-options-check.mjs",
    "open-source:check": "node scripts/open-source-check.mjs",
    "release:workflow-check": "node scripts/release-workflow-check.mjs",
    "provider-model-source-status:check": "node scripts/provider-model-source-status-check.mjs",
    "provider-model-catalog:check": "node scripts/provider-model-catalog-check.mjs",
    "translation-latency:check": "node scripts/translation-latency-check.mjs",
    "verify": "pnpm typecheck && pnpm build && pnpm validate && pnpm hotkey && pnpm provider-options:check && pnpm provider-model-options:check && pnpm provider-model-source-status:check && pnpm provider-model-catalog:check && pnpm translation-latency:check && pnpm popup-options:check && pnpm inline-renderer:check && pnpm translatable-element:check && pnpm hover-tracker:check && pnpm youtube-subtitles-shared:check && pnpm youtube-caption-tracks:check && pnpm youtube-transcript-fetch:check && pnpm youtube-subtitle-ui:check && pnpm youtube-subtitle-session:check && pnpm youtube-subtitle-protocol:check && pnpm helper:test && pnpm native:installer:check && pnpm native:compatibility-check && pnpm native:browser-targets-check && pnpm native:paths-check && pnpm native-host-update:check && pnpm release:workflow-check && pnpm native:cross-platform-workflow-check && pnpm open-source:check",
    "test": "pnpm verify"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "packageManager": "pnpm@10.32.1"
}
