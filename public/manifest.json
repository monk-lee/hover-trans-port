{
  "manifest_version": 3,
  "name": "Hover Trans Port",
  "description": "Translate selected or hovered text with a local AI provider.",
  "version": "0.1.0",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hover Trans Port"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "permissions": ["activeTab", "storage", "nativeMessaging"]
}
